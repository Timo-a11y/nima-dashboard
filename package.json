{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "main": "electron-dist/main.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:web": "next dev --turbopack",
    "dev:electron": "wait-on http://localhost:3000 && npm run build:electron && ELECTRON_RENDERER_URL=http://localhost:3000 electron ./electron-dist/main.js",
    "dev:desktop": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build": "next build",
    "build:web": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:desktop": "npm run build:web && npm run build:electron",
    "start": "next start",
    "start:desktop": "npm run build:desktop && electron ./electron-dist/main.js",
    "dist:mac": "npm run build:desktop && electron-builder --mac",
    "lint": "next lint"
  },
  "dependencies": {
    "googleapis": "^166.0.0",
    "mime-types": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "15.3.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@tailwindcss/postcss": "^4",
    "concurrently": "^9.2.1",
    "electron": "^38.6.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.cursor.googledrive.desktop",
    "productName": "Google Drive Desktop MVP",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
